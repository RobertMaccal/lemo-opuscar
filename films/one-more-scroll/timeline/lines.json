{
 "duration": 265.3,
 "lines": [
  {
   "id": "v1",
   "who": "PHONE",
   "t0": 32.1,
   "t1": 39.914,
   "text": "As a doctor, I strongly recommend eight hours of sleep! Anyway, I haven't slept in three days. Follow for more!"
  },
  {
   "id": "v3",
   "who": "PHONE",
   "t0": 46.15,
   "t1": 49.485,
   "text": "Twelve chairs. One jump. Let's GO!"
  },
  {
   "id": "v5",
   "who": "PHONE",
   "t0": 62.0,
   "t1": 63.639,
   "text": "POOL DAY, BABY!"
  },
  {
   "id": "j01",
   "who": "JEFF",
   "t0": 66.3,
   "t1": 69.912,
   "text": "Okay... I think it's time to sleep."
  },
  {
   "id": "m02",
   "who": "MARK",
   "t0": 123.15,
   "t1": 124.19,
   "text": "Morning, Jeff!"
  },
  {
   "id": "j03",
   "who": "JEFF",
   "t0": 124.8,
   "t1": 126.505,
   "text": "...morning."
  },
  {
   "id": "p04",
   "who": "PRIYA",
   "t0": 139.3,
   "t1": 143.023,
   "text": "Jeff, the boss needs you. He wants to see you in his office."
  },
  {
   "id": "b05",
   "who": "BOSS",
   "t0": 150.45,
   "t1": 153.513,
   "text": "Jeff! Do you have any idea what you're doing?"
  },
  {
   "id": "b06",
   "who": "BOSS",
   "t0": 155.6,
   "t1": 161.118,
   "text": "Your work has been terrible lately. You come here every single day looking like you're dead!"
  },
  {
   "id": "b07",
   "who": "BOSS",
   "t0": 161.6,
   "t1": 168.452,
   "text": "The sales are going down. You're barely doing anything! Honestly, I'm going to have to fire you, Jeff."
  },
  {
   "id": "j08",
   "who": "JEFF",
   "t0": 169.2,
   "t1": 170.503,
   "text": "Whatever, boss..."
  },
  {
   "id": "b09",
   "who": "BOSS",
   "t0": 175.45,
   "t1": 179.871,
   "text": "ARE YOU EVEN LISTENING TO ME, JEFF?! I SAID I MIGHT HAVE TO FIRE YOU!"
  },
  {
   "id": "j10",
   "who": "JEFF",
   "t0": 180.7,
   "t1": 182.807,
   "text": "Yeah... whatever, boss."
  },
  {
   "id": "b11",
   "who": "BOSS",
   "t0": 183.75,
   "t1": 186.897,
   "text": "GET OUT! We'll talk later. Go!"
  },
  {
   "id": "j12",
   "who": "JEFF",
   "t0": 242.7,
   "t1": 246.503,
   "text": "Who the hell are you? What are you doing in my place?"
  },
  {
   "id": "s13",
   "who": "STRANGER",
   "t0": 248.0,
   "t1": 249.999,
   "text": "I was like that yesterday, Jeff."
  },
  {
   "id": "j14",
   "who": "JEFF",
   "t0": 250.75,
   "t1": 252.383,
   "text": "Who the hell are you?"
  },
  {
   "id": "s15",
   "who": "STRANGER",
   "t0": 253.7,
   "t1": 254.874,
   "text": "I am you."
  },
  {
   "id": "s16",
   "who": "STRANGER",
   "t0": 255.7,
   "t1": 257.834,
   "text": "And you're in trouble."
  }
 ],
